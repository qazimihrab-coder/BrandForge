<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BrandForge | Logo & Nickname</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap');

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#05060a;
    --card:#0d1018;
    --card2:#111521;
    --line:rgba(255,255,255,.09);
    --text:#ffffff;
    --muted:#8f98aa;
    --blue:#5b7cff;
    --purple:#9b5cff;
    --cyan:#38d9ff;
    --danger:#ff4d6d;
}

body{
    font-family:"Vazirmatn",sans-serif;
    background:
        radial-gradient(circle at 20% 10%,rgba(91,124,255,.16),transparent 30%),
        radial-gradient(circle at 80% 20%,rgba(155,92,255,.14),transparent 28%),
        var(--bg);
    color:var(--text);
    min-height:100vh;
    overflow-x:hidden;
}

button,input{
    font-family:inherit;
}

button{
    cursor:pointer;
}

.app{
    width:100%;
    min-height:100vh;
    padding:20px;
}

header{
    max-width:1100px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 0 35px;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:22px;
    font-weight:900;
}

.logo-icon{
    width:44px;
    height:44px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,var(--blue),var(--purple));
    box-shadow:0 0 35px rgba(91,124,255,.35);
    font-size:22px;
}

.header-badge{
    padding:8px 13px;
    border:1px solid var(--line);
    border-radius:999px;
    color:#b8c0d0;
    font-size:12px;
    background:rgba(255,255,255,.025);
}

.screen{
    max-width:1100px;
    margin:auto;
    display:none;
    animation:fade .35s ease;
}

.screen.active{
    display:block;
}

@keyframes fade{
    from{
        opacity:0;
        transform:translateY(12px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.hero{
    text-align:center;
    padding:30px 0 45px;
}

.hero .mini{
    display:inline-block;
    color:#9aa9ff;
    background:rgba(91,124,255,.09);
    border:1px solid rgba(91,124,255,.22);
    border-radius:999px;
    padding:8px 14px;
    font-size:13px;
    margin-bottom:20px;
}

.hero h1{
    font-size:clamp(40px,8vw,78px);
    line-height:1;
    letter-spacing:-3px;
    margin-bottom:20px;
}

.gradient{
    background:linear-gradient(90deg,#fff,#8da0ff,#c28cff);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    color:var(--muted);
    max-width:620px;
    margin:auto;
    line-height:2;
    font-size:15px;
}

.choice-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
    max-width:850px;
    margin:auto;
}

.choice-card{
    position:relative;
    overflow:hidden;
    border:1px solid var(--line);
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.015));
    border-radius:28px;
    padding:35px 28px;
    text-align:right;
    transition:.3s;
}

.choice-card:hover{
    transform:translateY(-5px);
    border-color:rgba(91,124,255,.4);
    box-shadow:0 20px 60px rgba(0,0,0,.35);
}

.choice-card::before{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    border-radius:50%;
    background:var(--blue);
    filter:blur(80px);
    opacity:.12;
    top:-80px;
    left:-60px;
}

.choice-card.nick::before{
    background:var(--purple);
}

.choice-icon{
    width:68px;
    height:68px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:20px;
    background:rgba(91,124,255,.12);
    border:1px solid rgba(91,124,255,.2);
    font-size:30px;
    margin-bottom:25px;
}

.nick .choice-icon{
    background:rgba(155,92,255,.12);
    border-color:rgba(155,92,255,.2);
}

.choice-card h2{
    font-size:25px;
    margin-bottom:10px;
}

.choice-card p{
    color:var(--muted);
    line-height:1.9;
    font-size:14px;
    min-height:55px;
}

.select-btn{
    margin-top:25px;
    width:100%;
    border:0;
    border-radius:15px;
    padding:14px;
    color:white;
    font-weight:800;
    background:linear-gradient(135deg,var(--blue),#7557ff);
}

.nick .select-btn{
    background:linear-gradient(135deg,#8b52ff,#c04dff);
}

.top-title{
    text-align:center;
    margin:15px 0 35px;
}

.top-title h2{
    font-size:32px;
    margin-bottom:10px;
}

.top-title p{
    color:var(--muted);
    font-size:14px;
}

.back{
    border:1px solid var(--line);
    color:#c7ccda;
    background:rgba(255,255,255,.03);
    padding:10px 15px;
    border-radius:12px;
    margin-bottom:20px;
}

.option-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.option{
    border:1px solid var(--line);
    background:var(--card);
    color:#dce1eb;
    padding:22px 12px;
    border-radius:18px;
    text-align:center;
    transition:.25s;
}

.option:hover{
    border-color:var(--blue);
    transform:translateY(-3px);
    background:var(--card2);
}

.option .emoji{
    display:block;
    font-size:28px;
    margin-bottom:10px;
}

.form-card{
    max-width:720px;
    margin:auto;
    background:rgba(13,16,24,.8);
    border:1px solid var(--line);
    border-radius:28px;
    padding:28px;
}

.form-group{
    margin-bottom:22px;
}

.form-group label{
    display:block;
    margin-bottom:10px;
    font-weight:700;
}

.input{
    width:100%;
    border:1px solid var(--line);
    background:#080b12;
    color:white;
    padding:16px;
    border-radius:14px;
    outline:none;
    font-size:15px;
}

.input:focus{
    border-color:var(--blue);
    box-shadow:0 0 0 3px rgba(91,124,255,.08);
}

.style-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.style{
    border:1px solid var(--line);
    background:#090c13;
    color:#bbc2d0;
    padding:13px 8px;
    border-radius:12px;
    transition:.2s;
}

.style.selected{
    border-color:var(--blue);
    color:white;
    background:rgba(91,124,255,.12);
}

.primary{
    width:100%;
    border:0;
    border-radius:15px;
    padding:16px;
    color:white;
    font-weight:900;
    font-size:15px;
    background:linear-gradient(135deg,var(--blue),var(--purple));
    box-shadow:0 12px 35px rgba(91,124,255,.18);
}

.results-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:22px;
}

.results-header h2{
    font-size:27px;
}

.small-btn{
    border:1px solid var(--line);
    background:rgba(255,255,255,.04);
    color:#dce1eb;
    padding:10px 14px;
    border-radius:12px;
}

.results{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.result-card{
    border:1px solid var(--line);
    background:linear-gradient(145deg,#0d111b,#080a10);
    border-radius:22px;
    padding:22px;
    position:relative;
}

.result-number{
    color:#697386;
    font-size:11px;
    margin-bottom:12px;
}

.result-value{
    font-size:25px;
    font-weight:900;
    direction:ltr;
    text-align:center;
    padding:20px 5px;
    word-break:break-word;
}

.copy{
    width:100%;
    border:1px solid rgba(91,124,255,.25);
    background:rgba(91,124,255,.08);
    color:#b9c6ff;
    padding:11px;
    border-radius:12px;
    font-weight:700;
}

.logo-preview{
    height:180px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:18px;
    margin-bottom:15px;
    background:
        radial-gradient(circle,rgba(91,124,255,.16),transparent 50%),
        #070910;
    border:1px solid rgba(255,255,255,.05);
}

.logo-mark{
    width:105px;
    height:105px;
    border-radius:28px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32px;
    font-weight:900;
    background:linear-gradient(135deg,#5b7cff,#a15cff);
    box-shadow:0 15px 50px rgba(91,124,255,.3);
}

.logo-name{
    text-align:center;
    font-size:18px;
    font-weight:800;
    margin-bottom:12px;
}

footer{
    text-align:center;
    color:#596174;
    font-size:12px;
    padding:45px 0 20px;
}

@media(max-width:700px){
    .app{
        padding:14px;
    }

    header{
        padding-bottom:15px;
    }

    .header-badge{
        display:none;
    }

    .hero{
        padding:25px 0 30px;
    }

    .hero h1{
        letter-spacing:-2px;
    }

    .choice-grid,
    .results{
        grid-template-columns:1fr;
    }

    .choice-card{
        padding:27px 22px;
    }

    .option-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .style-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .form-card{
        padding:20px;
    }
}
</style>
</head>

<body>

<div class="app">

<header>
    <div class="logo">
        <div class="logo-icon">✦</div>
        <span>BrandForge</span>
    </div>

    <div class="header-badge">
        Create Your Identity
    </div>
</header>

<!-- SCREEN 1 -->
<section id="home" class="screen active">

    <div class="hero">
        <span class="mini">YOUR DIGITAL IDENTITY</span>

        <h1>
            بساز.
            <span class="gradient">خاص باش.</span>
        </h1>

        <p>
            برای برند، پیج، گیم، پروژه یا پروفایل خودت
            لوگو و نیک‌نیم حرفه‌ای بساز.
        </p>
    </div>

    <div class="choice-grid">

        <div class="choice-card">
            <div class="choice-icon">🎨</div>

            <h2>ساخت لوگو</h2>

            <p>
                برای برند، کسب‌وکار، پیج، گیم،
                پروژه یا برند شخصی یک لوگوی خاص بساز.
            </p>

            <button class="select-btn" onclick="chooseType('logo')">
                ساخت لوگو ←
            </button>
        </div>

        <div class="choice-card nick">
            <div class="choice-icon">👑</div>

            <h2>ساخت نیک‌نیم</h2>

            <p>
                برای Gaming، TikTok، Instagram،
                Telegram یا پروفایل شخصی نیک‌نیم بساز.
            </p>

            <button class="select-btn" onclick="chooseType('nick')">
                ساخت نیک‌نیم ←
            </button>
        </div>

    </div>

</section>


<!-- SCREEN 2 -->
<section id="purpose" class="screen">

    <button class="back" onclick="goHome()">← برگشت</button>

    <div class="top-title">
        <h2 id="purposeTitle">برای چه چیزی؟</h2>
        <p>یک گزینه انتخاب کن تا وارد مرحله بعد شویم.</p>
    </div>

    <div id="purposeGrid" class="option-grid"></div>

</section>


<!-- SCREEN 3 -->
<section id="builder" class="screen">

    <button class="back" onclick="showScreen('purpose')">← برگشت</button>

    <div class="top-title">
        <h2 id="builderTitle">ساخت</h2>
        <p>اطلاعات خودت را وارد کن و نتیجه بگیر.</p>
    </div>

    <div class="form-card">

        <div class="form-group">
            <label id="inputLabel">نام</label>

            <input
                id="mainInput"
                class="input"
                type="text"
                placeholder="مثلاً MihRab"
            >
        </div>

        <div class="form-group">

            <label>سبک مورد علاقه</label>

            <div id="styleGrid" class="style-grid"></div>

        </div>

        <button class="primary" onclick="generateResults()">
            ✨ تولید نتیجه
        </button>

    </div>

</section>


<!-- SCREEN 4 -->
<section id="resultsScreen" class="screen">

    <button class="back" onclick="showScreen('builder')">← برگشت</button>

    <div class="results-header">
        <div>
            <h2 id="resultsTitle">نتایج</h2>
        </div>

        <button class="small-btn" onclick="generateResults()">
            🔄 دوباره
        </button>
    </div>

    <div id="results" class="results"></div>

</section>

<footer>
    BrandForge © 2026 — Create Your Identity
</footer>

</div>


<script>

let currentType = "";
let currentPurpose = "";
let selectedStyle = "Modern";

const purposes = {

    logo: [
        ["🏢","کسب‌وکار"],
        ["📱","Instagram"],
        ["🎮","Gaming"],
        ["💻","Technology"],
        ["🎬","YouTube"],
        ["🛍️","فروشگاه"],
        ["👤","برند شخصی"],
        ["✨","سایر"]
    ],

    nick: [
        ["🎮","Gaming"],
        ["📱","Instagram"],
        ["🎵","TikTok"],
        ["💬","Telegram"],
        ["👑","شخصی"],
        ["💻","Coding"],
        ["😈","Dark"],
        ["✨","فانتزی"]
    ]

};

const logoStyles = [
    "Modern",
    "Minimal",
    "Luxury",
    "Gaming",
    "Dark",
    "Tech"
];

const nickStyles = [
    "Cool",
    "Gaming",
    "Dark",
    "Luxury",
    "Cute",
    "Symbols"
];


function showScreen(id){

    document.querySelectorAll(".screen").forEach(screen=>{
        screen.classList.remove("active");
    });

    document.getElementById(id).classList.add("active");

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


function goHome(){
    currentType = "";
    currentPurpose = "";
    showScreen("home");
}


function chooseType(type){

    currentType = type;

    const grid = document.getElementById("purposeGrid");

    grid.innerHTML = "";

    purposes[type].forEach(item=>{

        const button = document.createElement("button");

        button.className = "option";

        button.innerHTML = `
            <span class="emoji">${item[0]}</span>
            ${item[1]}
        `;

        button.onclick = ()=>{
            choosePurpose(item[1]);
        };

        grid.appendChild(button);

    });

    document.getElementById("purposeTitle").textContent =
        type === "logo"
        ? "لوگو را برای چه چیزی می‌خواهی؟"
        : "نیک‌نیم را برای چه چیزی می‌خواهی؟";

    showScreen("purpose");
}


function choosePurpose(purpose){

    currentPurpose = purpose;

    const styles =
        currentType === "logo"
        ? logoStyles
        : nickStyles;

    const styleGrid = document.getElementById("styleGrid");

    styleGrid.innerHTML = "";

    styles.forEach((style,index)=>{

        const button = document.createElement("button");

        button.className =
            "style" + (index === 0 ? " selected" : "");

        button.textContent = style;

        button.onclick = ()=>{

            document
                .querySelectorAll(".style")
                .forEach(x=>x.classList.remove("selected"));

            button.classList.add("selected");

            selectedStyle = style;

        };

        styleGrid.appendChild(button);

    });


    if(currentType === "logo"){

        document.getElementById("builderTitle").textContent =
            "ساخت لوگو";

        document.getElementById("inputLabel").textContent =
            "نام برند یا پروژه";

        document.getElementById("mainInput").placeholder =
            "مثلاً BrandForge";

    }else{

        document.getElementById("builderTitle").textContent =
            "ساخت نیک‌نیم";

        document.getElementById("inputLabel").textContent =
            "اسم یا کلمه مورد نظر";

        document.getElementById("mainInput").placeholder =
            "مثلاً MihRab";

    }

    showScreen("builder");
}


function generateResults(){

    const input =
        document.getElementById("mainInput")
        .value
        .trim();

    if(!input){

        alert(
            currentType === "logo"
            ? "اول نام برند یا پروژه را وارد کن."
            : "اول اسم یا کلمه مورد نظر را وارد کن."
        );

        return;
    }

    if(currentType === "logo"){
        generateLogos(input);
    }else{
        generateNicknames(input);
    }

    showScreen("resultsScreen");
}


function generateLogos(name){

    const results =
        document.getElementById("results");

    results.innerHTML = "";

    const initials =
        name
        .split(" ")
        .map(x=>x[0])
        .join("")
        .substring(0,3)
        .toUpperCase();

    const logoNames = [
        name,
        name.toUpperCase(),
        initials,
        "✦ " + initials,
        initials + " • " + name
    ];

    logoNames.forEach((value,index)=>{

        const card =
            document.createElement("div");

        card.className = "result-card";

        card.innerHTML = `

            <div class="result-number">
                DESIGN ${String(index+1).padStart(2,"0")}
            </div>

            <div class="logo-preview">

                <div class="logo-mark">
                    ${escapeHtml(initials)}
                </div>

            </div>

            <div class="logo-name">
                ${escapeHtml(value)}
            </div>

            <button class="copy"
                onclick="copyText('${escapeAttribute(value)}')">
                📋 کپی نام
            </button>

        `;

        results.appendChild(card);

    });

    document.getElementById("resultsTitle").textContent =
        "طرح‌های پیشنهادی لوگو";
}


function generateNicknames(name){

    const clean =
        name.replace(/\s+/g,"");

    let list = [];

    if(selectedStyle === "Gaming"){

        list = [
            "亗" + clean + "亗",
            "乂" + clean + "乂",
            "『" + clean + "』",
            "メ" + clean + "メ",
            "么" + clean + "么",
            "ツ" + clean + "ツ",
            "〆" + clean + "〆",
            "★" + clean + "★"
        ];

    }else if(selectedStyle === "Dark"){

        list = [
            "☠" + clean,
            "𖤐" + clean,
            "Dark_" + clean,
            "VOID_" + clean,
            "NØX_" + clean,
            "†" + clean + "†",
            "𝕯𝖆𝖗𝖐_" + clean,
            "☾" + clean
        ];

    }else if(selectedStyle === "Luxury"){

        list = [
            "𝑴𝒓_" + clean,
            "𝑳𝒆𝒈𝒆𝒏𝒅_" + clean,
            "𝐄𝐥𝐢𝐭𝐞_" + clean,
            "𝑹𝒐𝒚𝒂𝒍_" + clean,
            "♛" + clean,
            "𝓛𝓸𝓻𝓭_" + clean,
            "𝑩𝒐𝒔𝒔_" + clean,
            "♕" + clean
        ];

    }else if(selectedStyle === "Cute"){

        list = [
            "♡" + clean + "♡",
            "꒰" + clean + "꒱",
            "✿" + clean + "✿",
            "ʚ" + clean + "ɞ",
            "୨" + clean + "୧",
            "☁" + clean,
            "☆" + clean + "☆",
            "♡_" + clean
        ];

    }else if(selectedStyle === "Symbols"){

        list = [
            "『" + clean + "』",
            "【" + clean + "】",
            "〘" + clean + "〙",
            "〈" + clean + "〉",
            "《" + clean + "》",
            "꧁" + clean + "꧂",
            "乂" + clean + "乂",
            "メ" + clean + "メ"
        ];

    }else{

        list = [
            "Its" + clean,
            "The" + clean,
            clean + "X",
            clean + "_Official",
            "Real_" + clean,
            clean + "_01",
            "Mr_" + clean,
            "Only_" + clean
        ];

    }


    const results =
        document.getElementById("results");

    results.innerHTML = "";

    list.forEach((value,index)=>{

        const card =
            document.createElement("div");

        card.className = "result-card";

        card.innerHTML = `

            <div class="result-number">
                NICKNAME ${String(index+1).padStart(2,"0")}
            </div>

            <div class="result-value">
                ${escapeHtml(value)}
            </div>

            <button class="copy"
                onclick="copyText('${escapeAttribute(value)}')">
                📋 کپی نیک‌نیم
            </button>

        `;

        results.appendChild(card);

    });

    document.getElementById("resultsTitle").textContent =
        "نیک‌نیم‌های پیشنهادی";
}


function copyText(text){

    navigator.clipboard
        .writeText(text)
        .then(()=>{

            alert("کپی شد ✅");

        })
        .catch(()=>{

            const area =
                document.createElement("textarea");

            area.value = text;

            document.body.appendChild(area);

            area.select();

            document.execCommand("copy");

            area.remove();

            alert("کپی شد ✅");

        });

}


function escapeHtml(text){

    return text
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function escapeAttribute(text){

    return text
        .replace(/\\/g,"\\\\")
        .replace(/'/g,"\\'")
        .replace(/"/g,"&quot;");

}

</script>

</body>
</html>
